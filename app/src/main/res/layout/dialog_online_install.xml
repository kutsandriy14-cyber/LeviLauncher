<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_instance_card"
    android:backgroundTint="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Установка Minecraft"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:fontFamily="@font/misans"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tab_release"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Release"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/on_primary"
            android:background="@drawable/bg_filter_chip"
            android:backgroundTint="@color/primary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_beta"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="Beta/Preview"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/online_versions_recycler"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

    <TextView
        android:id="@+id/btn_close"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="20dp"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:fontFamily="@font/misans"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
